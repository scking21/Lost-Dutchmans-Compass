# Configure secrets only through the approved hosting secret manager.
QLOO_API_KEY=
APP_ORIGIN=http://localhost:3000
PORT=3000
# Production default; old MAX_LIVE_RUNS=3 alone does not enable pilot mode.
ACCESS_MODE=judging
# Used only with explicit ACCESS_MODE=pilot; not durable account limits.
MAX_LIVE_RUNS=3
MAX_DISPATCH_CREDITS=12
# Optional; no default expiry. Exact UTC YYYY-MM-DDTHH:mm:ss.sssZ.
LIVE_ACCESS_UNTIL=
